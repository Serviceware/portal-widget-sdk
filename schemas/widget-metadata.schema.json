{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Widget Metadata",
    "type": "object",
    "required": ["id", "name", "meta", "widgetVersion"],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "logo": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "changedOn": { "type": "string" },
        "meta": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["language", "name"],
                "properties": {
                    "language": { "type": "string", "minLength": 2 },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "descriptionShort": { "type": "string" }
                },
                "additionalProperties": false
            }
        },
        "widgetVersion": {
            "type": "object",
            "required": ["id", "name", "number", "state", "authenticated", "angularVersion", "defaultSize", "changes"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "name": { "type": "string" },
                "number": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
                },
                "date": { "type": "string" },
                "state": {
                    "type": "string",
                    "enum": ["dev", "preview", "released", "deprecated", "archived"]
                },
                "authenticated": { "type": "boolean" },
                "angularVersion": { "type": "number" },
                "portalVersion": { "type": "string", "enum": ["v2", "v3"] },
                "defaultSize": {
                    "type": "object",
                    "required": ["columns", "rows"],
                    "properties": {
                        "columns": { "type": "number", "minimum": 1 },
                        "rows": { "type": "number", "minimum": 1 }
                    },
                    "additionalProperties": false
                },
                "filename": { "type": "string" },
                "changes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["language", "description"],
                        "properties": {
                            "language": { "type": "string", "minLength": 2 },
                            "description": { "type": "string" }
                        },
                        "additionalProperties": false
                    }
                },
                "dependencies": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["name", "dependency"],
                        "properties": {
                            "name": { "type": "string" },
                            "dependency": { "type": "string" }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
