{
  "name": "@serviceware/portal-widget-sdk",
  "version": "0.1.0",
  "description": "Zero-dependency runtime for Serviceware Portal private widgets: toasts, settings dialog, navigation, skeleton, authenticated fetch, custom element helper.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serviceware/portal-widget-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Serviceware/portal-widget-sdk/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/Serviceware/portal-widget-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "./dist/contract.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/contract.ts --format esm,cjs --dts --clean --target es2020",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "serviceware",
    "portal",
    "widget",
    "custom-element",
    "web-component"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
