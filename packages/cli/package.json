{
  "name": "@serviceware/portal-widget-cli",
  "version": "0.0.0",
  "description": "Command line for Serviceware Portal private widgets: embed wizard, pack the import zip (embed or your own bundles), validate, unpack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serviceware/portal-widget-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Serviceware/portal-widget-sdk/tree/main/packages/cli#readme",
  "bugs": { "url": "https://github.com/Serviceware/portal-widget-sdk/issues" },
  "type": "module",
  "bin": { "portal-widget": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "assets", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tools",
    "refresh-embed-assets": "node tools/refresh-embed-assets.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": ["serviceware", "portal", "widget", "cli", "custom-element"],
  "publishConfig": { "access": "public", "provenance": true }
}
