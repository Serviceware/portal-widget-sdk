{
  "name": "portal-widget-sdk-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Public SDK and CLI for building Serviceware Portal private widgets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serviceware/portal-widget-sdk.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:examples": "pnpm -r --filter \"./examples/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "lint:examples": "pnpm -r --filter \"./examples/*\" lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
