{
  "name": "portal-widget-sdk-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Public SDK and CLI for building Serviceware Portal private widgets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serviceware/portal-widget-sdk.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "install:examples": "node scripts/examples.mjs install",
    "build:examples": "node scripts/examples.mjs build",
    "lint:examples": "eslint \"examples/*/src/**/*.{ts,tsx}\" \"examples/*/dev/*.ts\" \"examples/*/build.mjs\" scripts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
