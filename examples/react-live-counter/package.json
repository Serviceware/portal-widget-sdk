{
  "name": "@examples/react-live-counter",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "version": "1.0.0",
  "description": "Example private widget built with React 19 and TypeScript: a live, self-updating counter with a React settings form, driven by @serviceware/portal-widget-sdk.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "build:shadow": "tsc --noEmit && node build.mjs --css-mode shadow",
    "dev": "node build.mjs --watch --serve",
    "pack:widget": "portal-widget pack",
    "validate": "portal-widget validate portal-widget.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@serviceware/portal-widget-cli": "link:../../packages/cli",
    "@serviceware/portal-widget-sdk": "link:../../packages/sdk",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
