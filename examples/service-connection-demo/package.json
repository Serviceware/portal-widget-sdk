{
  "name": "@examples/service-connection-demo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "version": "1.0.0",
  "description": "Example private widget (EXPERIMENTAL): calls a third-party API through a Portal Service Connection, so the API key stays on the server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "build:shadow": "tsc --noEmit && node build.mjs --css-mode shadow",
    "dev": "node build.mjs --watch --serve",
    "pack:widget": "portal-widget pack",
    "validate": "portal-widget validate portal-widget.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@serviceware/portal-widget-cli": "link:../../packages/cli",
    "@serviceware/portal-widget-sdk": "link:../../packages/sdk",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
