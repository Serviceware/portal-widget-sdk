{
  "name": "@examples/astro-static-card",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "version": "1.0.0",
  "description": "Example private widget whose content is pre-rendered by Astro at build time: a static quick-links card in two languages, mounted by @serviceware/portal-widget-sdk.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "build:shadow": "tsc --noEmit && node build.mjs --css-mode shadow",
    "dev": "node build.mjs --watch --serve",
    "pack:widget": "portal-widget pack",
    "validate": "portal-widget validate portal-widget.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@serviceware/portal-widget-cli": "link:../../packages/cli",
    "@serviceware/portal-widget-sdk": "link:../../packages/sdk",
    "astro": "^7.3.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
